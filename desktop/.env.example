# Copy this file to .env and fill in any of the following. Every key is
# independent and optional. `.env` is gitignored and outside
# electron-builder.yml's files allowlist, so it never gets committed or
# bundled into a packaged build — this only affects `npm start` from your
# own checkout.
#
# All of this is applied once, only while the first-run wizard would
# otherwise open (a fresh install, or after clearing local storage) — it
# never overrides settings you've since changed in-app. Setting an Xtream
# account here always skips the wizard entirely; setting only locale/region
# still opens the wizard (for the Xtream step), just pre-filled.

# Xtream Codes panel — all three required together, or none are applied.
THUNDERTV_XTREAM_URL=http://example.com:8080
THUNDERTV_XTREAM_USERNAME=your-username
THUNDERTV_XTREAM_PASSWORD=your-password

# UI language: en, nl, or de.
THUNDERTV_LOCALE=en

# Live-filter country code: NL, BE, DE, UK, FR, ES, US, or blank for all countries.
THUNDERTV_LIVE_COUNTRY=NL
