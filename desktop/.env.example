# Copy this file to .env and fill in your own Xtream Codes panel
# credentials. `.env` is gitignored and outside electron-builder.yml's
# files allowlist, so it never gets committed or bundled into a packaged
# build — this only affects `npm start` from your own checkout.
#
# When present, ThunderTV auto-imports this as the active Xtream source on
# first launch, but only if no playlist source exists yet (a fresh install,
# or after clearing local storage) — it will not override an account you
# already configured in-app.

THUNDERTV_XTREAM_URL=http://example.com:8080
THUNDERTV_XTREAM_USERNAME=your-username
THUNDERTV_XTREAM_PASSWORD=your-password
