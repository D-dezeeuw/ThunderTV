# Copy to `.env` next to this file. Neither value has a safe default, and
# compose refuses to start without both.

# The provider host(s) this proxy may reach, comma-separated, `host:port`
# exactly as it appears in your playlist/Xtream URL. Without it the proxy will
# forward anywhere, and it is reachable from the internet through NPM.
ALLOWED_HOSTS=provider.example:8080

# The public https:// URL Nginx Proxy Manager serves this container on — no
# trailing slash. Rewritten HLS manifest URIs point back at this, so if it is
# wrong or missing the channel list loads fine and every video segment 404s.
PUBLIC_ORIGIN=https://iptv-proxy.example.com
