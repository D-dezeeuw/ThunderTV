root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,css,html,json,js,mjs,cjs}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[public/vendor/**]
# Vendored, verbatim — never reformatted.
insert_final_newline = false
