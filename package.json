{
    "name": "thundertv",
    "private": true,
    "version": "1.0.0",
    "description": "A compact, fast IPTV player for the web, desktop, and TV.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "vite",
        "predev": "npm run spektrum:csp",
        "build": "tsc --noEmit && vite build",
        "prebuild": "npm run spektrum:csp",
        "build:lg": "tsc --noEmit && vite build --mode webos && node scripts/package-target.mjs webos && node scripts/package-webos.mjs",
        "prebuild:lg": "npm run spektrum:csp",
        "preview": "vite preview",
        "deploy": "vite build && gh-pages -d dist --dotfiles",
        "predeploy": "npm run spektrum:csp",
        "lint": "eslint . --max-warnings 0",
        "lint:css": "node scripts/check-css.mjs",
        "lint:markup": "node scripts/check-markup.mjs",
        "lint:file-access": "node scripts/check-file-access-fence.mjs",
        "lint:importmap": "node scripts/check-importmap.mjs",
        "lint:csp": "node scripts/check-csp.mjs",
        "lint:version": "node scripts/check-version.mjs",
        "lint:reachability": "node scripts/check-reachability.mjs",
        "lint:dist": "node scripts/check-dist.mjs",
        "lint:desktop-package": "node scripts/check-desktop-package.mjs",
        "smoke:desktop": "npm run build && node scripts/package-target.mjs electron && node scripts/smoke-desktop.mjs",
        "smoke:desktop:packaged": "node scripts/smoke-desktop.mjs --packaged release/linux-unpacked/thundertv-desktop",
        "lint:state-keys": "node scripts/gen-state-keys.mjs --check",
        "lint:phase-status": "node scripts/gen-phase-status.mjs --check",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "bench:m3u": "vitest run --config vitest.bench.config.ts src/m3u/parser.bench.ts",
        "bench:list": "vitest run --config vitest.bench.config.ts src/ui/virtual-list.bench.ts",
        "gen:m3u-fixture": "node scripts/gen-m3u-fixture.mjs",
        "gen:epg-countries": "node scripts/generate-epg-countries.mjs",
        "spektrum:csp": "node scripts/spektrum-csp.mjs",
        "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run lint:markup && npm run lint:file-access && npm run lint:importmap && npm run lint:csp && npm run lint:version && npm run lint:reachability && npm run lint:state-keys && npm run lint:phase-status && npm run lint:desktop-package && npm test && vite build && npm run lint:dist"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "22.20.1",
        "@vitest/web-worker": "^4.1.10",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "fake-indexeddb": "6.2.5",
        "gh-pages": "6.3.0",
        "globals": "17.7.0",
        "icon-gen": "^5.0.0",
        "jsdom": "29.1.1",
        "png-to-ico": "^3.0.2",
        "prettier": "3.9.6",
        "sharp": "^0.35.3",
        "typescript": "6.0.2",
        "typescript-eslint": "8.65.0",
        "vite": "8.1.1",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "hls.js": "^1.6.16",
        "idb": "8.0.3",
        "iptv-playlist-parser": "github:4gray/iptv-playlist-parser#v0.15.2-iptvnator.2",
        "mpegts.js": "^1.8.0"
    },
    "overrides": {
        "sharp": "^0.35.3"
    }
}
