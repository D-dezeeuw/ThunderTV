{
    "name": "thundertv",
    "private": true,
    "version": "0.0.0",
    "description": "A compact, fast IPTV player for the web, desktop, and TV.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "deploy": "vite build && gh-pages -d dist --dotfiles",
        "lint": "eslint . --max-warnings 0",
        "lint:css": "node scripts/check-css.mjs",
        "lint:file-access": "node scripts/check-file-access-fence.mjs",
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "bench:m3u": "vitest run --config vitest.bench.config.ts",
        "gen:m3u-fixture": "node scripts/gen-m3u-fixture.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "22.20.1",
        "@vitest/web-worker": "^4.1.10",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "fake-indexeddb": "6.2.5",
        "gh-pages": "6.3.0",
        "globals": "17.7.0",
        "jsdom": "29.1.1",
        "prettier": "3.9.6",
        "typescript": "6.0.2",
        "typescript-eslint": "8.65.0",
        "vite": "8.1.1",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "idb": "8.0.3",
        "iptv-playlist-parser": "github:4gray/iptv-playlist-parser#v0.15.2-iptvnator.2"
    }
}
